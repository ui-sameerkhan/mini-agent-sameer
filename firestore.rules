rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------------------------
    // Identity
    //
    // Access is driven by users/{uid} — role plus assignedSites. Accounts that predate that
    // collection keep working through the legacy fallbacks below, which reproduce exactly the
    // access those logins already had. Nothing here grants a signed-in user blanket read/write.
    // ---------------------------------------------------------------------------------------

    // Bootstrap identity: the configured administrator email. This is the ONLY hard-coded
    // identity, and the only account that can be Super Admin without a profile document —
    // otherwise nobody could create the first profile.
    function adminEmails() {
      return ['admin@ktc-manpower.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(profilePath());
    }

    function profile() {
      return get(profilePath()).data;
    }

    // An account explicitly marked disabled loses everything, immediately.
    // The configured administrator can never be disabled by a document, for the same
    // break-glass reason as isConfiguredAdmin().
    function isDisabled() {
      return hasProfile() && !isConfiguredAdmin() &&
        profile().get('status', 'active') != 'active';
    }

    function isActive() {
      return isSignedIn() && !isDisabled();
    }

    // The configured administrator is Super Admin unconditionally, whatever any profile says.
    // Break-glass: without this, one malformed users/{uid} document demotes the only account
    // that can repair user access, and nobody can fix it from inside the app. The email comes
    // from these rules, not from data a user can write, so it is not an escalation path.
    function isConfiguredAdmin() {
      return isSignedIn() && email() in adminEmails();
    }

    // A document with no role was never provisioned as a profile — a stray field write must not
    // read as a grant of access — so such an account falls back to the legacy rules.
    function isProvisioned() {
      return hasProfile() && profile().get('role', '') != '';
    }

    function role() {
      return isConfiguredAdmin() ? 'super_admin'
        : (isProvisioned() ? profile().role : legacyRole());
    }

    // Pre-existing accounts, mapped to the access they already had:
    //  - configured admin email        -> super_admin
    //  - listed in `timekeepers`       -> timekeeper
    //  - on the office-staff domain    -> staff
    //  - anything else                 -> supervisor
    function legacyRole() {
      return email() in adminEmails() ? 'super_admin'
        : (exists(/databases/$(database)/documents/timekeepers/$(email())) ? 'timekeeper'
        : (email().matches('.*@ktcco[.]net') ? 'staff' : 'supervisor'));
    }

    function isSuperAdmin() {
      return isActive() && role() == 'super_admin';
    }

    function isAdmin() {
      return isActive() && role() == 'admin';
    }

    function isTimekeeper() {
      return isActive() && role() == 'timekeeper';
    }

    function isStaff() {
      return isActive() && role() == 'staff';
    }

    // Every role that records attendance for other people.
    function marksAttendance() {
      return isActive() &&
        role() in ['super_admin', 'admin', 'timekeeper', 'supervisor', 'foreman'];
    }

    // Roles that manage the workforce itself rather than only its attendance.
    function managesWorkers() {
      return isActive() && role() in ['super_admin', 'admin'];
    }

    // Roles that may add or update a roster entry. Timekeepers are included because keeping
    // their own site's roster current is the job — but only within the sites they hold, and
    // deleting people stays with managesWorkers() below.
    function uploadsRoster() {
      return isActive() && role() in ['super_admin', 'admin', 'timekeeper'];
    }

    // ---------------------------------------------------------------------------------------
    // Site scoping
    // ---------------------------------------------------------------------------------------

    // Super admins hold everything. An account with no profile keeps the company-wide access it
    // already had — narrowing it here would break working logins on upgrade, which is exactly
    // what this change must not do. Once Super Admin gives them a profile, that profile governs.
    function holdsAllSites() {
      return isSuperAdmin() || !isProvisioned() || ('ALL' in profile().get('assignedSites', []));
    }

    function hasSiteAccess(siteCode) {
      return isActive() && (holdsAllSites() || (siteCode != null && siteCode in profile().get('assignedSites', [])));
    }

    // ---------------------------------------------------------------------------------------
    // users/{uid} — roles and site assignments
    //
    // A user may read only their own profile; only Super Admin may read the whole list or write
    // any of it. Self-service role escalation is therefore impossible: nobody can grant
    // themselves a role or a site, because nobody can write their own profile.
    // ---------------------------------------------------------------------------------------
    function invitePath() {
      return /databases/$(database)/documents/userInvites/$(email());
    }

    function hasInvite() {
      return isSignedIn() && exists(invitePath());
    }

    function invite() {
      return get(invitePath()).data;
    }

    match /users/{uid} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update, delete: if isSuperAdmin();

      // Super Admin creates profiles directly. A user may also create their OWN profile, but
      // only by claiming an invite, and only with exactly the role and sites that invite names —
      // so claiming can never grant more than the administrator chose. This exists because a
      // profile must live at users/{uid}, and an account's UID is only ever visible to that
      // account, so access prepared for an existing login can't be written by the admin.
      allow create: if isSuperAdmin() || (
        isSignedIn() &&
        request.auth.uid == uid &&
        hasInvite() &&
        request.resource.data.email == email() &&
        request.resource.data.role == invite().role &&
        request.resource.data.assignedSites == invite().assignedSites &&
        request.resource.data.status == 'active'
      );
    }

    // userInvites/{email} — access prepared for a login that hasn't signed in yet. The invited
    // account may read its own invite (to claim it); only Super Admin may create or change one.
    match /userInvites/{inviteEmail} {
      allow read: if isSuperAdmin() || (isSignedIn() && inviteEmail == email());
      allow create, update: if isSuperAdmin();
      // The claiming account clears its own invite once the profile exists.
      allow delete: if isSuperAdmin() || (isSignedIn() && inviteEmail == email());
    }

    // ---------------------------------------------------------------------------------------
    // workers/{workerId} — the workforce, also serving as the roster.
    // Site-scoped for reads; only worker managers may write.
    // ---------------------------------------------------------------------------------------
    match /workers/{workerId} {
      // The roster is shared across sites, deliberately.
      //
      // Workers transfer between projects constantly, and the receiving site's timekeeper has to
      // be able to mark someone who turns up there today but is rostered elsewhere. Scoping the
      // roster made that impossible: the worker simply did not exist as far as that timekeeper
      // was concerned, so the transfer could not be recorded at all.
      //
      // What stays scoped is the attendance itself — who worked where, for how long, and every
      // correction — which is the payroll-bearing record. A roster row carries a name, an ID and
      // a trade; the confidential part is below, not here. A transfer is not hidden either: the
      // attendance record keeps the rostered site alongside the site actually worked and flags
      // the mismatch for review (see AttendanceEngine.mark).
      allow read: if isActive();
      allow create, update: if uploadsRoster() &&
        (holdsAllSites() || hasSiteAccess(request.resource.data.get('site', null)));
      // Removing someone from the workforce is narrower than editing them.
      allow delete: if managesWorkers() &&
        (holdsAllSites() || hasSiteAccess(resource.data.get('site', null)));
    }

    // sites/{siteCode} — geofence definitions. Readable by any active user (a site's coordinates
    // are needed to check in at all, and the list is needed to pick one); only Super Admin
    // configures them.
    match /sites/{siteCode} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // ---------------------------------------------------------------------------------------
    // attendance/{date_workerId}
    //
    // Staff may read and write only their own record, and only as self-marked attendance.
    // Everyone else is bound to the sites they hold.
    // ---------------------------------------------------------------------------------------
    match /attendance/{recordId} {
      allow read: if isActive() && (
        holdsAllSites() ||
        hasSiteAccess(resource.data.get('siteCode', null)) ||
        (isStaff() && hasProfile() && resource.data.workerId == profile().get('employeeId', null))
      );

      allow create: if isActive() && (
        (marksAttendance() && hasSiteAccess(request.resource.data.get('siteCode', null))) ||
        // Staff self check-in: only their own worker record, only at a site they hold.
        (isStaff() && hasProfile() &&
          request.resource.data.workerId == profile().get('employeeId', null) &&
          hasSiteAccess(request.resource.data.get('siteCode', null)))
      );

      allow update: if isActive() && (
        (marksAttendance() && hasSiteAccess(request.resource.data.get('siteCode', null))) ||
        (isStaff() && hasProfile() &&
          resource.data.workerId == profile().get('employeeId', null) &&
          request.resource.data.workerId == resource.data.workerId)
      );

      // Attendance is never deleted — corrections are recorded as edits, so the audit trail
      // survives. Only Super Admin can remove a record outright.
      allow delete: if isSuperAdmin();
    }

    // blocked/{autoId} — refused (outside-geofence) attempts. Anyone who can mark attendance can
    // log one; reviewing them is site-scoped.
    match /blocked/{docId} {
      allow read: if isActive() && (holdsAllSites() || hasSiteAccess(resource.data.get('siteCode', null)));
      allow create: if isActive();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // ---------------------------------------------------------------------------------------
    // transferRequests/{autoId} — a worker moving from one site to another.
    //
    // Raised by whoever is actually looking at the man (foreman, supervisor, timekeeper) and
    // approved by the receiving site's timekeeper. Head office is deliberately not in this loop:
    // a transfer is a fact observed at a gate, and requiring an admin to confirm it left the
    // roster stale — the worker kept counting against the site they had already left.
    // ---------------------------------------------------------------------------------------
    match /transferRequests/{docId} {
      // Both ends of the move can see it — the site gaining the worker and the site losing them.
      // Every clause tests the CALLER's site list against a field, never the field alone, so a
      // scoped account cannot widen the query to reach a transfer between two other sites.
      allow read: if isActive() && (
        holdsAllSites() ||
        hasSiteAccess(resource.data.get('toSite', null)) ||
        hasSiteAccess(resource.data.get('fromSite', null))
      );

      // Anyone who marks attendance may raise one, but only INTO a site they hold: a foreman can
      // pull a worker towards their own gate, never push one onto somebody else's site. It must
      // start pending, so raising a request can never be a disguised self-approval.
      allow create: if marksAttendance() &&
        hasSiteAccess(request.resource.data.get('toSite', null)) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.get('workerId', '') != '';

      // Approving one moves the roster, so it takes exactly the authority needed to write that
      // roster row at the receiving site: the site's timekeeper, or an admin above them. A
      // foreman is not in uploadsRoster(), so nobody can approve the request they just raised.
      allow update: if uploadsRoster() && hasSiteAccess(resource.data.get('toSite', null));
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // arrivalRequests/{autoId} — supervisor-submitted, admin-approved.
    match /arrivalRequests/{docId} {
      allow read: if isActive() && (holdsAllSites() || hasSiteAccess(resource.data.get('site', null)));
      allow create: if isActive();
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // ---------------------------------------------------------------------------------------
    // leaves/{autoId} — admin marks leave directly; office staff self-apply as "pending".
    // ---------------------------------------------------------------------------------------
    match /leaves/{docId} {
      allow read: if isActive() && (
        holdsAllSites() || isTimekeeper() ||
        hasSiteAccess(resource.data.get('site', null)) ||
        (resource.data.get('requestedBy', null) != null && resource.data.requestedBy.lower() == email())
      );
      allow create: if isSuperAdmin() || isAdmin() ||
        // A self-submitted application: must be in the applicant's own name and start pending.
        (isActive() && request.resource.data.get('requestedBy', null) != null &&
         request.resource.data.requestedBy.lower() == email() &&
         request.resource.data.status == 'pending');
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // staffWorkerLinks/{email} — binds an office-staff login to the worker ID it first used.
    match /staffWorkerLinks/{linkEmail} {
      allow read: if isSuperAdmin() || isAdmin() || (isActive() && linkEmail == email());
      allow create: if isActive() && linkEmail == email() &&
        request.resource.data.email == linkEmail;
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    // settings/{docId} — app configuration and the admin push token. Readable by any active
    // user (submitting an arrival request reads the token to notify admin); Super Admin writes.
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isSuperAdmin();
    }

    // announcements/{autoId} — broadcast banner, read by everyone, posted by admins.
    match /announcements/{docId} {
      allow read: if isActive();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }

    // pushTokens/{email} — one device token per account. Each user registers only their own.
    match /pushTokens/{tokenEmail} {
      allow read: if isSuperAdmin() || isAdmin();
      allow create, update: if isActive() && tokenEmail == email() &&
        request.resource.data.email == tokenEmail;
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // holidays/{date} — low-sensitivity reference data, read by any active user.
    match /holidays/{date} {
      allow read: if isActive();
      allow write: if isSuperAdmin() || isAdmin();
    }

    // timekeepers/{email} — retained from the pre-profile role system, so existing timekeeper
    // logins keep resolving while profiles are rolled out. Super Admin manages the list.
    match /timekeepers/{tkEmail} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
