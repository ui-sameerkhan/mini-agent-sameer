rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Update this list if you add more admin accounts later —
    // must match Constants.ADMIN_EMAILS in the Android app / ADMIN_EMAILS in the web app.
    function adminEmails() {
      return ['admin@ktc-manpower.com'];
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in adminEmails();
    }

    // workers/{workerId} — also doubles as the roster.
    // Read: any signed-in staff (check-in search, roster lookups).
    // Write: admin only — supervisors add people via arrivalRequests instead.
    match /workers/{workerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // sites/{siteCode} — geofence definitions.
    // Read: any signed-in staff (needed to check in/out at all).
    // Write: admin only.
    match /sites/{siteCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // attendance/{date_workerId} — check-in/out records.
    // Both admin and supervisor accounts mark attendance.
    match /attendance/{recordId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // blocked/{autoId} — outside-geofence attempts, logged by whoever tried to mark.
    // Only admin reviews them; anyone signed in can log one.
    match /blocked/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // arrivalRequests/{autoId} — supervisor-submitted, admin-approved.
    match /arrivalRequests/{docId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // leaves/{autoId} — admin marks leave directly (status "approved", no requestedBy);
    // office staff self-apply instead, which creates a "pending" doc the admin must
    // approve/reject. Office staff can also read back their own submitted requests.
    match /leaves/{docId} {
      allow read: if isAdmin() ||
        (isSignedIn() && resource.data.requestedBy != null &&
         resource.data.requestedBy.lower() == request.auth.token.email.lower());
      allow create: if isAdmin() ||
        (isSignedIn() && request.resource.data.requestedBy != null &&
         request.resource.data.requestedBy.lower() == request.auth.token.email.lower() &&
         request.resource.data.status == 'pending');
      allow update, delete: if isAdmin();
    }

    // staffWorkerLinks/{email} — permanently binds an office-staff login email (doc ID,
    // always stored lowercased by the app) to the first Worker ID it checked in with.
    // Owner can read/create their own link; only admin can change or remove one afterward
    // (e.g. correcting a mistaken first check-in).
    match /staffWorkerLinks/{email} {
      allow read: if isAdmin() || (isSignedIn() && email == request.auth.token.email.lower());
      allow create: if isSignedIn() && email == request.auth.token.email.lower() &&
        request.resource.data.email == email;
      allow update, delete: if isAdmin();
    }

    // settings/adminPushToken — the push token itself is only ever written by
    // an admin (Enable Notifications is admin-only), but it must be READABLE
    // by supervisors too: submitting a new-arrival request reads this token
    // to fire the push notification to the admin's device.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // announcements/{autoId} — admin broadcast, one message per doc. Every signed-in
    // user reads the latest one for the in-app banner; only admin can post one.
    match /announcements/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // pushTokens/{email} — one FCM device token per signed-in account (doc ID is the
    // lowercased login email), used to fan out admin announcements as real push
    // notifications. Each user can only register their own device; only admin reads
    // the full list, to actually send the broadcast.
    match /pushTokens/{email} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn() && email == request.auth.token.email.lower() &&
        request.resource.data.email == email;
      allow delete: if isAdmin();
    }
  }
}
