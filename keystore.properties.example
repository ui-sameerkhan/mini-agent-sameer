# Copy this file to keystore.properties (which is gitignored) and fill in
# your real values to build a signed release AAB/APK locally.
#
# Never commit keystore.properties or the .jks file itself — losing control
# of the signing key means you can no longer publish updates to an app
# already live on Google Play under it.

storeFile=/absolute/path/to/railgatelive-release.jks
storePassword=CHANGE_ME
keyAlias=railgatelive
keyPassword=CHANGE_ME
